{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erg-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "erg-platform"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "09c33e24bdbc46018bf27eae427ec2eb"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6c0dbec80f0a4fc493b6361b68a36e67"
    }
  ],
  "vars": {
    "GITHUB_REPO": "ErGaneshBabu99/erg-platform",
    "NEXT_PUBLIC_SITE_URL": "https://www.erganesh.com.np",
    "NEXT_PUBLIC_SUPABASE_URL": "https://pngfoiugheajfvitrwdu.supabase.co",
    "NEXT_PUBLIC_WHATSAPP_NUMBER": "+9779847805353",
    "OPENROUTER_MODEL": "meta-llama/llama-3.3-70b-instruct:free",
    "PUBLIC_EMAIL": "contact@erganesh.com.np",
    "PUBLIC_PHONE_NUMBER": "+9779847805353",
    "REPORT_CHECK_AI_PROVIDER": "gemini"
  }
}